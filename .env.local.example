# ─── Contact + Careers form email (Nodemailer) ───────────────────────────────
# Copy this file to .env.local and fill in your real SMTP credentials.
# .env.local is gitignored — never commit real credentials.
#
# Used by two routes, both landing at hr@bitsbuffer.com (confirmed 2026-07-17,
# hello@bitsbuffer.com was never a real mailbox):
#   /api/contact  -> sends to siteConfig.contact.email (hr@bitsbuffer.com)
#   /api/careers  -> sends to hr@bitsbuffer.com, with the resume attached
# Same SMTP account authenticates both (teams@bitsbuffer.com), matching the
# pattern already live on wfengine.com's /api/demo route.

# ── Gmail / Google Workspace ──────────────────────────────────────────────────
# 1. Go to: https://myaccount.google.com/security → 2-Step Verification → ON
# 2. Then: https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" → copy the 16-char password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=teams@bitsbuffer.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=teams@bitsbuffer.com

# ── Zoho Mail ────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USER=teams@bitsbuffer.com
# SMTP_PASS=your-zoho-password
# SMTP_FROM=teams@bitsbuffer.com

# ── cPanel / custom hosting ───────────────────────────────────────────────────
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=teams@bitsbuffer.com
# SMTP_PASS=your-email-password
# SMTP_FROM=teams@bitsbuffer.com

NEXT_PUBLIC_SITE_URL=https://www.bitsbuffer.com

# ── Blog admin panel (added 2026-07-18) ───────────────────────────────────────
# Requires a local (or hosted) MongoDB instance.
MONGODB_URI=mongodb://127.0.0.1:27017/bitsbuffer

# Single admin login. Plain text on purpose (2026-07-22): this is a
# single-admin panel, and the previous bcrypt hash's $ characters kept
# getting corrupted differently across .env.local vs. hosting-panel env
# var fields. The login route still compares this via a constant-time
# hash-then-compare, not a bare ===. Never commit a real password into
# this example file, this line is a placeholder only.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-your-own-password

# Signs the admin session cookie -- any random 32+ char string. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-plus-character-string
