# Added 2026-07-17: this project had no .gitignore at all, and .env.local
# holds real SMTP credentials (used by /api/contact and /api/careers).
# Standard Next.js ignore list, nothing project-specific beyond that.

# dependencies
/node_modules

# next.js
/.next/
/.next-dev/
/.next-audit/
/out/
next-env.d.ts
*.tsbuildinfo

# production
/build

# env files -- never commit real credentials
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# blog admin panel -- content-drafts/ is a working inbox (scripts/watch-drafts.ts),
# imported/rejected files are local working state, not source
/content-drafts/imported/
/content-drafts/rejected/

# manual test/audit run output (Lighthouse, axe-core, screenshots, server
# logs) -- 43MB of one-off artifacts, not source, not read by the app.
# Removed 2026-07-30: was skewing this repo's GitHub language stats to
# 95%+ HTML purely from committed Lighthouse report bytes.
/audit/
